# Reverse proxy in front of the api container — the app is never bound to
# a public port directly (docker-compose.prod.yml has no `ports:` on api).
#
# workforceos.online — Caddy automatically requests and renews a free
# Let's Encrypt certificate for this domain on startup, no other config
# needed. Requires the domain's DNS A record to point at this server and
# not be Cloudflare-proxied (DNS only / grey cloud) — a proxied record
# would intercept the ACME HTTP challenge before it reaches Caddy. See
# docs/11_DEPLOYMENT.md.

workforceos.online {
	reverse_proxy api:8000
}
