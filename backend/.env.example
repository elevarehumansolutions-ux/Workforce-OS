# Copy to .env and fill in real values. Never commit .env itself.

# --- Application ---
APP_VERSION=0.1.0
APP_URL=http://localhost:8000
DEBUG=true

# --- Database (main application, RLS-scoped role, no BYPASSRLS) ---
# See backend/scripts/db/provision_app_role.sql — a real, non-superuser,
# non-BYPASSRLS role, distinct from the superuser that owns the schema.
DATABASE_URL=postgresql+psycopg://elevare_app:changeme@localhost:5432/elevare

# Alembic-only — needs the schema-owning superuser's DDL privileges.
MIGRATION_DATABASE_URL=postgresql+psycopg://elevare:changeme@localhost:5432/elevare

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth tokens ---
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# --- Environment ---
# Controls the refresh-token cookie's Secure flag (true in staging/production,
# false in local dev since it runs over plain HTTP). See 03_ARCHITECTURE.md.
ENVIRONMENT=development

# --- CORS ---
# JSON list of allowed frontend origins. Never a wildcard. See 03_ARCHITECTURE.md.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- LLM provider (AI Suggestions, executive summaries) ---
ANTHROPIC_API_KEY=changeme
# Tiered models: cheap/fast for simple picks, strong for reasoning (06_AI_DESIGN.md).
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_STRONG=claude-sonnet-5

# --- AI suggestion guardrails (08_DECISIONS.md 2026-09-25) ---
AI_MAX_MISSING_DEPARTMENTS_PER_RUN=3
AI_MAX_CRITICAL_POSITIONS_PER_DEPARTMENT_PER_RUN=3
AI_MAX_PENDING_MISSING_DEPARTMENTS=5

# --- Email (Notifications module, lands in M3) ---
# When true, outgoing email is logged instead of sent — no Resend account
# needed. Set to false only once RESEND_API_KEY is a real key and the
# sending domain in MAIL_FROM is verified in Resend's dashboard.
EMAIL_STUB_MODE=true
EMAIL_VERIFICATION_TOKEN_EXPIRY=24
RESEND_API_KEY=changeme
MAIL_FROM=Elevare Workforce OS <noreply@workforceos.online>

# --- Payment (Paystack, primary, per 08_DECISIONS.md) ---
PAYSTACK_SECRET_KEY=changeme
PAYSTACK_PUBLIC_KEY=changeme
