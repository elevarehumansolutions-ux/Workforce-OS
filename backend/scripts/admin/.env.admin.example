# Copy to .env.admin and fill in the real password after running
# provision_platform_admin_role.sql. Never commit .env.admin itself.
#
# This credential is read ONLY by scripts/admin/ — never by docker-compose's
# env_file (api/celery_worker/celery_beat never see this). See 07_SECURITY.md:
# the platform_admin role carries BYPASSRLS, so keeping it out of the app's
# own environment is what makes RLS a real boundary rather than a suggestion.
PLATFORM_ADMIN_DATABASE_URL=postgresql+psycopg://elevare_platform_admin:changeme@db:5432/elevare_db
