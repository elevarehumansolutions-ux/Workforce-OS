# Copy to .env.db and fill in the real value before running
# provision_app_role.sql. Never commit .env.db itself.
#
# This credential is read ONLY when manually provisioning elevare_app —
# never by docker-compose's env_file (api/celery_worker/celery_beat never
# see this file), and never by pydantic-settings' Settings() (which would
# crash on an undeclared key, per the note at the top of the main .env).
# Should match elevare_app's password in the main .env's DATABASE_URL —
# this is the same credential, just supplied here instead of embedded in
# the provisioning script itself.
ELEVARE_APP_DB_PASSWORD=changeme
